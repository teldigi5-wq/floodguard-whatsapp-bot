PORT=8080
# Local-only by default; use HTTPS reverse proxy / secure tunnel for remote administration.
HOST=127.0.0.1
DATA_PATH=./data
FIREBASE_DATABASE_URL=https://floodguard-e3215-default-rtdb.asia-southeast1.firebasedatabase.app
# Leave empty with your current public /floodguard/live rules.
FIREBASE_AUTH=
# Consider data stale if no Firebase update arrives for this long.
FLOODGUARD_STALE_MS=15000

# HC-SR04 sensor face to reservoir bottom (cm)
WATER_SENSOR_TO_BOTTOM_CM=25

# REQUIRED before admin setup page /, /status or /qr can be accessed.
# Generate privately: node -p "require('crypto').randomBytes(32).toString('base64')"
# Use a long, random, no-whitespace token (32+ ASCII chars); never commit the value.
FLOODGUARD_SETUP_TOKEN=
# The Basic Auth prompt uses username 'admin' and this value as the password.
# Expose setup UI remotely only over HTTPS via trusted reverse proxy/TLS termination.
# Do not expose port 8080 directly to the internet on any hosting provider.
