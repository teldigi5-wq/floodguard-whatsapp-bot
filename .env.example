PORT=8080
DATA_PATH=./data
FIREBASE_DATABASE_URL=https://floodguard-e3215-default-rtdb.asia-southeast1.firebasedatabase.app
# Leave empty with your current public /floodguard/live rules.
FIREBASE_AUTH=
# Consider data stale if no Firebase update arrives for this long.
FLOODGUARD_STALE_MS=15000

# HC-SR04 sensor face to reservoir bottom (cm)
WATER_SENSOR_TO_BOTTOM_CM=25
